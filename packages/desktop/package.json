{
  "name": "@mail-archiver/desktop",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/preload.cjs','dist/preload.cjs')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && electron .",
    "dist": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@mail-archiver/core": "*",
    "@mail-archiver/server": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3"
  },
  "description": "Mail Archiver - The Mail Backup Solution",
  "author": "sphings79",
  "homepage": "https://github.com/sphings79/mail-archiver",
  "repository": {
    "type": "git",
    "url": "https://github.com/sphings79/mail-archiver.git"
  }
}
